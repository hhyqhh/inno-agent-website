---
/**
 * NewsBanner - 以 News 形式展示 Inno Agent 生态与工具集成
 */
import { withBase } from '../utils/base';

type NewsItem = {
  /** 左侧标识图：要么是图片路径，要么是内联 SVG 字符串 */
  logoSrc?: string;
  logoAlt?: string;
  iconSvg?: string;
  iconBg?: string;
  /** 顶部标签 */
  tag: string;
  /** 标题（支持在内部用 <a> 占位的 HTML 片段） */
  title: string;
  /** 描述 */
  description: string;
  /** 主按钮 */
  primary: { label: string; href: string; external?: boolean };
  /** 次按钮 */
  secondary?: { label: string; href: string; external?: boolean };
};

// 数组按时间正序维护（新新闻追加到末尾），渲染时倒序，最新在最上
const items: NewsItem[] = [
  {
    logoSrc: withBase('/images/partners/verymath-logo.png'),
    logoAlt: 'VeryMath Logo',
    tag: 'News · 生态动态',
    title:
      'Inno Agent 已完成对 <a href="https://verymath.github.io" target="_blank" rel="noopener noreferrer" class="text-[#555aff] underline decoration-[#c7d0ff] decoration-2 underline-offset-4 transition-colors hover:decoration-[#555aff]">VeryMath</a> 的适配与集成',
    description:
      'VeryMath 是由华东师范大学数学科学学院研发，面向 AI 辅助数学研究的开源平台，致力于构建可复用、可验证、可协作的科研流程，覆盖论文阅读、数学计算、形式化验证与自动化研究。Inno Agent 已将其核心能力作为工作区模板接入，开箱即用。',
    primary: { label: '访问 VeryMath 主页', href: 'https://verymath.github.io', external: true },
    secondary: { label: '查看集成的工作区', href: '#skills' },
  },
  {
    iconSvg:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6"/><path d="M10 3v6.2L4.6 18a2.5 2.5 0 0 0 2.2 3.8h10.4A2.5 2.5 0 0 0 19.4 18L14 9.2V3"/><path d="M7.5 14.5h9"/><path d="M9 17.5h6"/></svg>',
    iconBg: 'linear-gradient(135deg,#555aff 0%,#4ca6ff 55%,#0f9f8f 100%)',
    tag: 'News · 工具生态',
    title:
      '新工具 <a href="https://github.com/Rick2Ricardo/skyclass-distill" target="_blank" rel="noopener noreferrer" class="text-[#555aff] underline decoration-[#c7d0ff] decoration-2 underline-offset-4 transition-colors hover:decoration-[#555aff]">SkyClass Distill</a>：把课程蒸馏成可复用的 Skill',
    description:
      '一款教学蒸馏工作台，支持从 B 站、优酷等线上平台或本地视频收集课程，用 Faster Whisper 本地转写，再借助 OpenAI 兼容接口提炼单课与跨课程共性的教学能力，产出带证据溯源的 Skill 文件。导出后即可在 Inno Agent 中作为技能直接使用。',
    primary: {
      label: '查看 SkyClass Distill',
      href: 'https://github.com/Rick2Ricardo/skyclass-distill',
      external: true,
    },
  },
  {
    iconSvg:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4h20v12H2z"/><path d="M8 20h8"/><path d="M12 16v4"/><path d="M12 7l1.1 2.2 2.4.4-1.7 1.7.4 2.4L12 12.6l-2.2 1.1.4-2.4-1.7-1.7 2.4-.4z"/></svg>',
    iconBg: 'linear-gradient(135deg,#f59e0b 0%,#555aff 60%,#4ca6ff 100%)',
    tag: 'News · 展会动态',
    title:
      'InnoAgent 教育智能体将作为 AI 赋能教育实践案例，亮相 <a href="https://mp.weixin.qq.com/s/UenhrLNAUPdp6bssYHoqnQ" target="_blank" rel="noopener noreferrer" class="text-[#555aff] underline decoration-[#c7d0ff] decoration-2 underline-offset-4 transition-colors hover:decoration-[#555aff]">WAIC 2026 世界人工智能大会</a>',
    description:
      'InnoAgent 教育智能体入选 WAIC 2026 世界人工智能大会 AI 赋能教育实践案例展示，呈现分层记忆架构如何把学习者画像、知识 Wiki 与主动复习组织成可持续的教学闭环，让通用大模型真正走进长期、个性化的学习场景。',
    primary: {
      label: '阅读原文',
      href: 'https://mp.weixin.qq.com/s/UenhrLNAUPdp6bssYHoqnQ',
      external: true,
    },
  },
];
---

<section class="relative overflow-hidden bg-[#fbfdff] px-6 py-12 sm:py-16">
  <div class="tech-dots absolute inset-0 pointer-events-none opacity-60"></div>
  <div class="mx-auto max-w-6xl relative">
    <div
      data-news-list
      class:list={[
        'relative flex flex-col gap-6',
        items.length > 2 && 'news-scroll overflow-y-auto pr-3',
      ]}
    >
      {
        [...items].reverse().map((item) => (
          <div class="fade-in-up tech-card group relative flex shrink-0 flex-col gap-6 overflow-hidden rounded-2xl border border-[#dbe4ff] bg-white p-6 shadow-sm sm:flex-row sm:items-start sm:gap-8 sm:p-8">
          {/* 渐变装饰边 */}
          <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-[#555aff] via-[#4ca6ff] to-[#0f9f8f]" aria-hidden="true" />

          {/* 标识图 */}
          {item.logoSrc ? (
            <a
              href={item.primary.href}
              target={item.primary.external ? '_blank' : undefined}
              rel={item.primary.external ? 'noopener noreferrer' : undefined}
              class="relative shrink-0 sm:mt-6 focus-visible:outline-2 focus-visible:outline-[#555aff] focus-visible:outline-offset-4"
              aria-label={item.logoAlt ?? item.primary.label}
            >
              <img
                src={item.logoSrc}
                alt={item.logoAlt ?? ''}
                width="88"
                height="88"
                class="h-16 w-16 rounded-2xl border border-[#e1e8ff] bg-white object-cover shadow-md transition-transform duration-300 group-hover:scale-105 sm:h-20 sm:w-20"
              />
            </a>
          ) : (
            <a
              href={item.primary.href}
              target={item.primary.external ? '_blank' : undefined}
              rel={item.primary.external ? 'noopener noreferrer' : undefined}
              class="relative shrink-0 sm:mt-6 focus-visible:outline-2 focus-visible:outline-[#555aff] focus-visible:outline-offset-4"
              aria-label={item.primary.label}
            >
              <span
                class="flex h-16 w-16 items-center justify-center rounded-2xl border border-[#e1e8ff] p-4 text-white shadow-md transition-transform duration-300 group-hover:scale-105 sm:h-20 sm:w-20"
                style={`background:${item.iconBg ?? '#555aff'}`}
                aria-hidden="true"
                set:html={item.iconSvg}
              />
            </a>
          )}

          {/* 文案 */}
          <div class="flex-1">
            <div class="mb-2 inline-flex items-center gap-2">
              <span class="tech-pulse inline-block h-2 w-2 rounded-full bg-[#555aff]" aria-hidden="true" />
              <span class="text-xs font-bold uppercase tracking-wider text-[#555aff]">{item.tag}</span>
            </div>
            <h2 class="text-xl font-bold leading-snug text-slate-950 sm:text-2xl" set:html={item.title} />
            <p class="mt-3 text-sm leading-7 text-slate-600 sm:text-base">{item.description}</p>
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <a
                href={item.primary.href}
                target={item.primary.external ? '_blank' : undefined}
                rel={item.primary.external ? 'noopener noreferrer' : undefined}
                class="tech-cta inline-flex items-center gap-2 rounded-full bg-[#555aff] px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-[#464cf0] focus-visible:outline-2 focus-visible:outline-[#555aff] focus-visible:outline-offset-2"
              >
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101M10.172 13.828a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
                {item.primary.label}
              </a>
              {item.secondary && (
                <a
                  href={item.secondary.href}
                  target={item.secondary.external ? '_blank' : undefined}
                  rel={item.secondary.external ? 'noopener noreferrer' : undefined}
                  class="inline-flex items-center gap-1.5 rounded-full border border-[#dfe5ff] bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition-colors hover:border-[#555aff] hover:text-[#555aff]"
                >
                  {item.secondary.label}
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        </div>
      ))
    }
    </div>
    {
      items.length > 2 && (
        <div
          data-news-fade
          class="pointer-events-none absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-[#fbfdff] to-transparent transition-opacity duration-300"
          aria-hidden="true"
        />
      )
    }
  </div>
</section>

<script>
  const newsList = document.querySelector('[data-news-list]');
  if (newsList instanceof HTMLElement && newsList.classList.contains('news-scroll')) {
    const fade = document.querySelector('[data-news-fade]');
    const cards = Array.from(newsList.children);

    const updateMaxHeight = () => {
      if (cards.length <= 2) return;
      const gap = parseFloat(getComputedStyle(newsList).rowGap) || 0;
      const first = cards[0] as HTMLElement;
      const second = cards[1] as HTMLElement;
      newsList.style.maxHeight = `${first.offsetHeight + second.offsetHeight + gap}px`;
    };

    const updateFade = () => {
      if (!(fade instanceof HTMLElement)) return;
      const atBottom = newsList.scrollTop + newsList.clientHeight >= newsList.scrollHeight - 8;
      fade.style.opacity = atBottom ? '0' : '1';
    };

    updateMaxHeight();
    updateFade();
    window.addEventListener('load', updateMaxHeight);
    window.addEventListener('resize', updateMaxHeight);
    newsList.addEventListener('scroll', updateFade, { passive: true });
  }
</script>
