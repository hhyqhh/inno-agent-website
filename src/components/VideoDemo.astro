---
/**
 * VideoDemo section — 场景演示展示区
 */
const demos = [
  {
    title: '雅思备考工作区',
    description: '从零搭建一个雅思口语练习工作区，3 分钟跑通完整流程',
    image: '/images/docs/01_new_workspace.png',
    label: 'Workspace',
    href: '/tutorials/skill-tutorial/',
  },
  {
    title: 'Skill 编写教程',
    description: '编写一个自动生词卡 Skill，让 Agent 把生词变成 Anki 卡片',
    image: '/images/docs/upload-workspace-skill.gif',
    label: 'Skill',
    href: '/tutorials/skill-tutorial/',
  },
  {
    title: '立体几何解题',
    description: '上传几何题照片，Agent 自动生成 Three.js 交互式解题页面',
    image: '/images/docs/edu-solid-geometry-demo.gif',
    label: 'Interactive',
    href: '/skill-library/',
  },
];
---

<section class="relative border-y border-[#e6ecff] bg-[#f4f8ff] px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase text-[#555aff]">Scenarios</p>
        <h2 class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          看看它能做什么
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          从工作区、Skill 到交互式解题，把抽象能力落到真实学习流程里。
        </p>
      </div>
      <a href="/tutorials/teaching-assistant/" class="inline-flex items-center gap-2 self-start rounded-full border border-[#dfe5ff] bg-white px-4 py-2 text-sm font-semibold text-[#555aff] shadow-sm transition-colors hover:border-[#555aff] hover:bg-[#f8faff] lg:self-auto">
        教师上手指南
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {demos.map((demo) => (
        <a href={demo.href}
           class="group block overflow-hidden rounded-lg border border-[#e5ebff] bg-white shadow-sm shadow-[#d8e2ff]/40 transition-colors hover:border-[#cfd8ff] focus-visible:outline-2 focus-visible:outline-[#555aff] focus-visible:outline-offset-2">
          <div class="relative aspect-video border-b border-[#e5ebff] bg-[#eef4ff]">
            <img src={demo.image} alt={demo.title} width="960" height="540" class="h-full w-full object-cover" loading="lazy" />
            <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-xs font-semibold text-[#555aff] shadow-sm">
              {demo.label}
            </span>
          </div>
          <div class="p-5">
            <h3 class="mb-2 text-base font-semibold text-slate-950 group-hover:text-[#555aff]">{demo.title}</h3>
            <p class="text-sm leading-6 text-slate-600">{demo.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
