---
/**
 * VideoDemo section — 场景演示展示区
 */
import { withBase } from '../utils/base';
const demos = [
  {
    title: '立体几何解题',
    description: '上传几何题照片，Agent 自动生成 Three.js 交互式 3D 解题页面',
    video: '/videos/edu-solid-final.mp4',
    poster: '/videos/edu-solid-final-poster.jpg',
    label: 'Interactive',
    href: '/skill-library/',
  },
  {
    title: '一键生成 PPT',
    description: '上传文档，自动产出结构清晰、可编辑的 SVG 幻灯片演示',
    video: '/videos/ppt-demo.mp4',
    poster: '/videos/ppt-demo-poster.jpg',
    label: 'PPT',
    href: '/skill-library/',
  },
  {
    title: '发光水母动画',
    description: '一句自然语言描述，Agent 生成 Canvas 粒子发光动画',
    video: '/videos/glowing-jellyfish.mp4',
    poster: '/videos/glowing-jellyfish-poster.jpg',
    label: '创作',
    href: '/skill-library/',
  },
  {
    title: '作文批改',
    description: '上传作文，Agent 自动批改并给出评分与逐句修改建议',
    video: '/videos/essay-grading.mp4',
    poster: '/videos/essay-grading-poster.jpg',
    label: '教育',
    href: '/skill-library/',
  },
];
---

<section class="tech-divider relative border-y border-[#e6ecff] bg-[#f4f8ff] px-6 py-20 sm:py-28">
  <div class="tech-grid tech-grid--wide absolute inset-0 pointer-events-none"></div>
  <div class="mx-auto max-w-6xl relative">
    <div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="fade-in-up max-w-2xl">
        <p class="text-sm font-semibold uppercase text-[#555aff]">Scenarios</p>
        <h2 class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          看看它能做什么
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          从工作区、Skill 到交互式解题，把抽象能力落到真实学习流程里。
        </p>
      </div>
      <a href={withBase('/tutorials/teaching-assistant/')} class="fade-in-up inline-flex items-center gap-2 self-start rounded-full border border-[#dfe5ff] bg-white px-4 py-2 text-sm font-semibold text-[#555aff] shadow-sm transition-colors hover:border-[#555aff] hover:bg-[#f8faff] lg:self-auto" data-delay="1">
        教师上手指南
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-2">
      {demos.map((demo, i) => (
        <a href={withBase(demo.href)}
           class={`fade-in-up tech-card group block overflow-hidden rounded-lg border border-[#e5ebff] bg-white shadow-sm shadow-[#d8e2ff]/40 focus-visible:outline-2 focus-visible:outline-[#555aff] focus-visible:outline-offset-2`}
           data-delay={String(i + 1)}>
          <div class="relative aspect-video border-b border-[#e5ebff] bg-[#eef4ff]">
            <video data-demo-video src={withBase(demo.video)} poster={withBase(demo.poster)} muted loop playsinline preload="none" class="h-full w-full object-cover" aria-label={demo.title} />
            <span class="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-xs font-semibold text-[#555aff] shadow-sm backdrop-blur-sm">
              {demo.label}
            </span>
          </div>
          <div class="p-5">
            <h3 class="mb-2 text-base font-semibold text-slate-950 group-hover:text-[#555aff] transition-colors">{demo.title}</h3>
            <p class="text-sm leading-6 text-slate-600">{demo.description}</p>
          </div>
        </a>
      ))}
    </div>

    <script>
      const videos = document.querySelectorAll('[data-demo-video]');
      videos.forEach((video) => {
        const card = video.closest('a');
        if (!card) return;
        card.addEventListener('mouseenter', () => video.play().catch(() => {}));
        card.addEventListener('mouseleave', () => {
          video.pause();
          video.currentTime = 0;
        });
      });
    </script>
  </div>
</section>
