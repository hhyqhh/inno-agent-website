---
/**
 * Features section — 核心特性展示
 */
const features = [
  {
    icon: 'L1',
    title: '开放学习者模型',
    description: '目标、掌握度、误区、偏好和复习时间来自结构化学习事件，学习者可以查看、修正和追溯依据。',
    accent: 'bg-[#555aff]',
  },
  {
    icon: 'L2',
    title: '原生 Wiki 知识记忆',
    description: '学习资料被归档成来源、实体、概念和分析页面，支持引用、维护和图谱化查询。',
    accent: 'bg-[#0f9f8f]',
  },
  {
    icon: 'L3',
    title: '会话记录与工具轨迹',
    description: '近期对话、工具调用和运行记录由会话层承载，避免把临时聊天混入长期画像和知识库。',
    accent: 'bg-[#f59e0b]',
  },
  {
    icon: 'S',
    title: '主动学习调度',
    description: '支持每日复盘、间隔复习、知识库更新、学习档案反思和自定义任务，并可推送到个人渠道。',
    accent: 'bg-[#4ca6ff]',
  },
  {
    icon: 'P',
    title: 'Practice Lab 实践闭环',
    description: 'Agent 生成练习文件和建议命令，用户运行后保留输出记录，再基于真实运行结果继续讲解。',
    accent: 'bg-[#8b6cff]',
  },
  {
    icon: 'D',
    title: '本地优先与模型可替换',
    description: '数据默认存在本地文件，模型接口兼容多个 provider，也为更小、更快的教育专用模型预留了接入路径。',
    accent: 'bg-[#475569]',
  },
];
---

<section class="relative bg-white px-6 py-20 sm:py-28">
  <div class="tech-dots absolute inset-0 pointer-events-none"></div>
  <div class="mx-auto max-w-6xl relative">
    <div class="fade-in-up mb-12 max-w-2xl">
      <p class="text-sm font-semibold uppercase text-[#555aff]">Core Capabilities</p>
      <h2 class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
        六大核心模块，覆盖完整学习链路
      </h2>
      <p class="mt-4 text-lg leading-8 text-slate-600">
        每个模块对应一个真实的学习动作：建档、归档、对话、复习、练习、部署，组合成可运行的长期学习系统。
      </p>
    </div>

    <div class="tech-card-3d grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <div class={`fade-in-up tech-card rounded-lg border border-[#e5ebff] bg-[#fbfdff] p-6 shadow-sm shadow-[#d8e2ff]/30`} data-delay={String(i + 1)}>
          <div class={`tech-icon-glow mb-5 flex h-10 w-10 items-center justify-center rounded-md ${f.accent} text-sm font-bold text-white`} aria-hidden="true">
            {f.icon}
          </div>
          <h3 class="mb-2 text-lg font-semibold text-slate-950">{f.title}</h3>
          <p class="text-sm leading-7 text-slate-600">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
