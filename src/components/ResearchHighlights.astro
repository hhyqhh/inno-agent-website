---
/**
 * ResearchHighlights — 系统亮点展示
 */
const pillars = [
  {
    label: 'L1',
    title: '学习者画像',
    description: '目标、掌握度、误区、偏好和复习时机被沉淀为可查看、可修正的长期档案。',
    accent: 'bg-[#555aff]',
  },
  {
    label: 'L2',
    title: '原生知识 Wiki',
    description: '资料被整理成来源、实体、概念和分析页面，保留出处，比单纯向量召回更可审计。',
    accent: 'bg-[#0f9f8f]',
  },
  {
    label: 'L3',
    title: '会话与工具轨迹',
    description: '近期对话、工具调用和运行记录留在会话层，服务连续交互而不污染长期记忆。',
    accent: 'bg-[#f59e0b]',
  },
];

const highlights = [
  {
    title: '把\u201C会聊天\u201D升级为长期学习陪伴',
    description:
      '学习不是一次性问答，而是目标变化、误区修复、资料积累和复习节奏共同构成的长期循环。Inno Agent 用分层记忆把这些状态显式化，让每次对话都带着学习上下文继续。',
    video: '/media/l1-profile.mp4',
    alt: 'Inno Agent 学习者画像界面截图',
  },
  {
    title: '知识不是黑盒召回，而是可维护的 Wiki',
    description:
      'PDF、Office、图片和文本资料会进入 L2 知识层，形成 source-summary、entity、concept、analysis 等页面。学习者和 Agent 都能追溯来源、修改页面、围绕知识图谱继续提问。',
    video: '/media/l2-wiki.mp4',
    alt: 'Inno Agent L2 Wiki 知识库界面截图',
  },
  {
    title: '主动调度 + 多渠道，把复习推进到真实生活里',
    description:
      'Scheduler 支持每日复盘、间隔复习、知识库更新、学习档案反思和自定义任务，并可通过飞书、QQ、微信等个人入口推送，让 Agent 不只等待用户打开网页。',
    video: '/media/scheduler-desktop.mp4',
    alt: 'Inno Agent 主动学习调度器界面截图',
  },
  {
    title: 'Practice Lab 让编程学习闭环发生在同一个工作台',
    description:
      'Agent 生成练习文件和建议命令，用户点击运行，终端输出被保存为 run record。下一轮提问会带着运行尾部上下文，支持从错误、输出和实验现象继续讲解。',
    video: '/media/practice-lab.mp4',
    alt: 'Inno Agent Practice Lab 代码运行界面截图',
  },
];

const metrics = [
  { value: '3 层', label: '长期记忆架构' },
  { value: '7 类', label: '内置学习调度任务' },
  { value: 'PDF / Office / Image', label: '资料解析入口' },
  { value: '本地文件', label: '默认持久化方式' },
];
---

<section id="research" class="tech-divider relative overflow-hidden border-b border-[#e6ecff] bg-[#fbfdff] px-6 py-20 sm:py-28">
  <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(85,90,255,0.08),rgba(15,159,143,0.06)_40%,rgba(245,158,11,0.07)_100%)]"></div>
  <div class="tech-grid tech-grid--offset absolute inset-0 pointer-events-none"></div>

  <div class="relative mx-auto max-w-6xl">
    <div class="mb-12 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-end">
      <div class="fade-in-up">
        <p class="text-sm font-semibold uppercase text-[#0f9f8f]">System Highlights</p>
        <h2 class="mt-3 text-3xl font-bold text-slate-950 sm:text-4xl">
          不只是聊天助手，而是完整的学习系统
        </h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          学习者模型、知识库、练习环境、主动复习和本地部署共同构成一个可运行的个人学习 Agent，每个能力都可独立使用，也可组合成闭环。
        </p>
      </div>

      <div class="fade-in-up grid grid-cols-2 gap-3 sm:grid-cols-4" data-delay="1">
        {metrics.map((item) => (
          <div class="tech-glass rounded-lg p-4 shadow-sm">
            <div class="text-lg font-bold text-slate-950">{item.value}</div>
            <div class="mt-1 text-xs leading-5 text-slate-500">{item.label}</div>
          </div>
        ))}
      </div>
    </div>

    <div class="mb-8 grid grid-cols-1 gap-4 lg:grid-cols-3">
      {pillars.map((pillar, i) => (
        <div class:list={['fade-in-up tech-card rounded-lg border border-[#e0e8f2] bg-white p-5 shadow-sm']} data-delay={String(i + 1)}>
          <div class:list={['tech-icon-glow mb-4 inline-flex h-9 min-w-9 items-center justify-center rounded-md px-2 text-sm font-bold text-white', pillar.accent]}>
            {pillar.label}
          </div>
          <h3 class="text-base font-semibold text-slate-950">{pillar.title}</h3>
          <p class="mt-2 text-sm leading-7 text-slate-600">{pillar.description}</p>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 gap-8">
      {highlights.map((item, index) => (
        <article class="fade-in-up tech-card research-article-grid overflow-hidden rounded-lg border border-[#dde7f3] bg-white shadow-sm">
          <div
            class:list={[
              'aspect-[16/9] border-b border-[#e5ebff] bg-[#eef4ff] lg:border-b-0 lg:border-r',
              index % 2 === 1 && 'lg:order-2 lg:border-l lg:border-r-0',
            ]}
          >
            <video src={item.video} autoplay muted loop playsinline preload="metadata" class="h-full w-full object-cover object-top" aria-label={item.alt} />
          </div>
          <div class:list={['flex flex-col justify-center p-6 lg:p-10', index % 2 === 1 && 'lg:order-1']}>
            <p class="mb-4 text-sm font-semibold uppercase text-[#0f9f8f]">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="text-2xl font-semibold leading-tight text-slate-950">{item.title}</h3>
            <p class="mt-4 text-base leading-8 text-slate-600">{item.description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="fade-in-up mt-8 grid gap-6 rounded-lg border border-[#dbe7f3] bg-white p-6 shadow-sm lg:grid-cols-[0.95fr_1.05fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase text-[#f59e0b]">Distillation Direction</p>
        <h3 class="mt-3 text-2xl font-bold text-slate-950">
          面向教育场景，训练更小、更快、可本地部署的模型
        </h3>
        <p class="mt-3 text-sm leading-7 text-slate-600">
          我们的目标不是复刻通用编码 Agent 的全部能力，而是蒸馏&ldquo;何时讲解、何时诊断、何时练习、何时调用学习工具&rdquo;的教育决策策略，让轻量模型也能胜任个性化教学。
        </p>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="tech-glass rounded-md p-4">
          <div class="text-sm font-semibold text-slate-950">教育推理数据</div>
          <div class="mt-2 text-xs leading-5 text-slate-500">讲解、诊断、出题、提示、复盘、画像更新</div>
        </div>
        <div class="tech-glass rounded-md p-4">
          <div class="text-sm font-semibold text-slate-950">工具轨迹蒸馏</div>
          <div class="mt-2 text-xs leading-5 text-slate-500">学习档案、L2 归档、调度任务、实验反馈</div>
        </div>
        <div class="tech-glass rounded-md p-4">
          <div class="text-sm font-semibold text-slate-950">本地部署目标</div>
          <div class="mt-2 text-xs leading-5 text-slate-500">本地 GPU、学校内网、组织私有服务器</div>
        </div>
        <div class="rounded-md border border-dashed border-[#cfd8ff] bg-white p-4">
          <div class="text-sm font-semibold text-slate-950">评测指标</div>
          <div class="mt-2 text-xs leading-5 text-slate-500">延迟、吞吐、成本、学习任务质量持续完善中</div>
        </div>
      </div>
    </div>
  </div>
</section>
