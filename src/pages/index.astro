<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Inno Agent — 开源、本地优先的个人学习 Agent。通过 L1 学习者画像、L2 知识 Wiki、L3 会话记忆、主动调度和 Practice Lab 构建长期学习闭环。" />
    <meta name="theme-color" content="#f8fbff" />
    <meta property="og:title" content="Inno Agent — 你的专属 AI 学习伙伴" />
    <meta property="og:description" content="分层记忆、开放学习者模型、知识 Wiki、主动复习和 Practice Lab 组成的长期学习 Agent" />
    <meta property="og:type" content="website" />
    <title>Inno Agent — 你的专属 AI 学习伙伴</title>
    <script is:inline>
      const storedTheme = (() => {
        try {
          return localStorage.getItem('starlight-theme');
        } catch {
          return null;
        }
      })();
      const prefersLight = matchMedia('(prefers-color-scheme: light)').matches;
      const theme = storedTheme === 'light' || storedTheme === 'dark'
        ? storedTheme
        : prefersLight ? 'light' : 'dark';
      document.documentElement.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#080c18' : '#f8fbff');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
